# Copy to .env with `pnpm env:local` (it also generates the local keys and secrets below).
# In Kubernetes variables come from the ConfigMap id-api-config and the SealedSecret
# id-api-secrets (envFrom), not from a file.
NODE_ENV=development
PORT=4100
LOG_LEVEL=info
APP_VERSION=dev
# Port of the separate Prometheus listener (GET /metrics); 0 turns it off.
METRICS_PORT=9471
# Proxy hops in front of the service: 1, id-web, which forwards the client address.
TRUST_PROXY_HOPS=1
SHUTDOWN_DELAY_MS=0

# Local dependencies of compose.yaml (pnpm infra:up).
DATABASE_URL=postgres://app:app@localhost:5441/app
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6391
RABBITMQ_URL=amqp://app:app@localhost:5681

TOKEN_ISSUER=http://localhost:3100
TOKEN_AUDIENCE=nick-lukashik
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_GRACE_MS=20000
LOGIN_CODE_TTL_SECONDS=600
LOGIN_RESEND_COOLDOWN_MS=60000
LOGIN_MAX_ATTEMPTS=5
NOTIFICATIONS_URL=http://localhost:4200

# Passkeys: id-web locally (localhost is a valid RP ID; an IP address is not).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=nick-lukashik (local)
WEBAUTHN_ORIGIN=http://localhost:3100
PASSKEY_FRESH_SIGN_IN_MS=900000
# Apps that sign in through id-web: client=redirect URI, comma-separated.
OAUTH_CLIENTS=landing-web=http://localhost:3000/auth/callback
# Google sign-in stays off while these are empty (Google Cloud Console, OAuth client
# "Web application", redirect URI = id-web's /login/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Secrets: generated by `pnpm env:local`, never committed.
SIGNING_KEY_PEM=
PREVIOUS_PUBLIC_KEYS=[]
LOGIN_CODE_PEPPER=
NOTIFICATIONS_INTERNAL_TOKEN=
INTERNAL_API_TOKEN=
